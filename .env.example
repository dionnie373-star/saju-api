# 이 파일을 .env로 복사해서 실제 값을 채운 뒤, 배포 플랫폼(Render/Railway 등)의
# 환경변수 설정에도 똑같이 등록하세요. .env 자체는 git에 커밋되지 않습니다.

# Claude API 키 (console.anthropic.com에서 발급)
ANTHROPIC_API_KEY=

# 이메일 발송 (권장: Brevo HTTP API - 포트 443이라 호스팅 방화벽에 안 막힘).
# Render 등 일부 무료 호스팅은 이메일 발송용 포트(25/465/587)를 막아버려서
# SMTP 방식은 소켓 연결에서 응답 없이 멈출 수 있다. BREVO_API_KEY를 설정하면
# 이 방식을 대신 사용한다 (app.brevo.com/settings/keys/api 에서 발급).
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=Palja

# BREVO_API_KEY가 없을 때만 사용되는 예전 SMTP 방식 (SendGrid/Mailgun/SES 등).
# 465(SSL)면 SendGrid 등, 587(STARTTLS)이면 Brevo 등 - 서비스가 알려주는 값 그대로 입력
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 랜딩페이지가 이 API를 호출할 도메인 (CORS). 배포 전 테스트 단계에서는
# 비워두면 전체 허용("*")으로 동작하고, 실사용자 오픈 전에 실제 랜딩페이지
# 도메인으로 좁히는 걸 권장합니다.
ALLOWED_ORIGIN=

# /internal/send-report(결제 후 유료·프리미엄 리포트 발송)를 보호하는 공유 비밀키.
# 결제 플랫폼 웹훅(또는 그 사이의 중계 스크립트)에서 X-Webhook-Secret 헤더로
# 이 값을 그대로 보내야 요청이 통과된다. 아무 값이나 길게 생성해서 넣으세요.
WEBHOOK_SECRET=
