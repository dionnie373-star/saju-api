# 이 파일을 .env로 복사해서 실제 값을 채운 뒤, 배포 플랫폼(Render/Railway 등)의
# 환경변수 설정에도 똑같이 등록하세요. .env 자체는 git에 커밋되지 않습니다.

# Claude API 키 (console.anthropic.com에서 발급)
ANTHROPIC_API_KEY=

# 이메일 발송 (권장: Brevo HTTP API - 포트 443이라 호스팅 방화벽에 안 막힘).
# Render 등 일부 무료 호스팅은 이메일 발송용 포트(25/465/587)를 막아버려서
# SMTP 방식은 소켓 연결에서 응답 없이 멈출 수 있다. BREVO_API_KEY를 설정하면
# 이 방식을 대신 사용한다 (app.brevo.com/settings/keys/api 에서 발급).
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=Palja

# BREVO_API_KEY가 없을 때만 사용되는 예전 SMTP 방식 (SendGrid/Mailgun/SES 등).
# 465(SSL)면 SendGrid 등, 587(STARTTLS)이면 Brevo 등 - 서비스가 알려주는 값 그대로 입력
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 랜딩페이지가 이 API를 호출할 도메인 (CORS). 배포 전 테스트 단계에서는
# 비워두면 전체 허용("*")으로 동작하고, 실사용자 오픈 전에 실제 랜딩페이지
# 도메인으로 좁히는 걸 권장합니다.
ALLOWED_ORIGIN=

# Paddle 결제 완료(transaction.completed) 웹훅 서명 검증용 시크릿 키.
# Paddle 대시보드 > Developer Tools > Notifications > 해당 destination
# > "Secret key" 값 (pdl_ntfset_로 시작). /webhooks/paddle 라우트가 이 값으로
# Paddle-Signature 헤더를 검증한다.
PADDLE_WEBHOOK_SECRET=

# Paddle 상품 가격(price) ID. 샌드박스/라이브가 서로 다른 ID를 쓰므로
# 환경변수로 관리한다 (app.py PADDLE_PRICE_TIER_MAP 참고). 비워두면 app.py의
# 샌드박스 기본값이 쓰인다 - 라이브 전환 시 이 세 값을 라이브 pri_... ID로
# 교체하면 코드 수정 없이 바로 라이브 결제로 전환된다.
#   샌드박스(지금까지 사용): PADDLE_PRICE_ID_PAID=pri_01m3f98f0s27hjx0xy4bc9em4d
#                          PADDLE_PRICE_ID_PREMIUM=pri_01m3f9bjxx7sgpr1wvm5g8k61r
#                          COMPATIBILITY_PADDLE_PRICE_ID=pri_01m3g7k8hqa7dggxxj8x5vnh1n
#   라이브(2026-09-28 생성, KYC/도메인 승인 후 전환 예정): PADDLE_PRICE_ID_PAID=pri_01m3g8n437px4nwp9syp1184t8
#                          PADDLE_PRICE_ID_PREMIUM=pri_01m3g8zk02bj740pefptt00vs1
#                          COMPATIBILITY_PADDLE_PRICE_ID=pri_01m3g950r9ynzeqhd1htkszmwb
PADDLE_PRICE_ID_PAID=
PADDLE_PRICE_ID_PREMIUM=
COMPATIBILITY_PADDLE_PRICE_ID=

# Paddle 서버 사이드 API 키. Products/Prices 등 API 조작에 쓴다 (지금은
# 카탈로그를 대시보드에서 직접 만들었으니 필수는 아니지만, 앞으로 스크립트로
# 카탈로그를 관리하려면 필요). Paddle 대시보드 > Developer Tools >
# Authentication에서 발급 (샌드박스: pdl_sdbx_apikey_..., 라이브: pdl_live_apikey_...).
PADDLE_SANDBOX_API_KEY=
PADDLE_API_KEY=
